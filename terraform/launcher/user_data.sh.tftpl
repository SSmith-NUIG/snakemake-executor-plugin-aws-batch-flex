#!/bin/bash
# zip md5 ${zip_md5} (changes here replace the instance)
set -euxo pipefail
exec > >(tee /var/log/snakemake-setup.log) 2>&1

dnf install -y unzip

cat > /tmp/setup-user.sh <<'EOS'
set -euxo pipefail
cd "$HOME"
aws s3 cp "s3://$BUCKET/$KEY" plugin.zip --region "$REGION"
unzip -q -o plugin.zip
curl -LsSf https://astral.sh/uv/install.sh | sh
export PATH="$HOME/.local/bin:$PATH"
cd snakemake-executor-plugin-aws-batch-flex
uv venv --python 3.12 .venv
. .venv/bin/activate
uv pip install -e . "snakemake==$SMK_VER" "snakemake-storage-plugin-s3==$S3_VER"
snakemake --executor aws-batch-flex --help | grep -q aws-batch-flex-queue

# conda on the launcher: Snakemake needs `conda` on the machine running it when --sdm conda is used
curl -fsSL -o miniforge.sh "https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-$(uname -m).sh"
bash miniforge.sh -b -p "$HOME/miniforge3" && rm -f miniforge.sh
echo 'export PATH="$PATH:$HOME/miniforge3/condabin"' >> "$HOME/.bashrc"

# smoke-test profile, pre-filled
cat > examples/smoke-test/profile/config.yaml <<EOP
executor: aws-batch-flex
default-storage-provider: s3
default-storage-prefix: $WORKDIR
aws-batch-flex-queue: $QUEUE
aws-batch-flex-region: $REGION
aws-batch-flex-bootstrap: host
aws-batch-flex-host-env-wait-seconds: 180
aws-batch-flex-default-image: debian:12
default-resources: [mem_mb=512]
jobs: 5
EOP
if [ -n "$JOB_ROLE" ]; then echo "aws-batch-flex-job-role-arn: $JOB_ROLE" >> examples/smoke-test/profile/config.yaml; fi

# every new shell: venv active, region set
{
  echo 'export PATH="$HOME/.local/bin:$PATH"'
  echo "export AWS_REGION=$REGION AWS_DEFAULT_REGION=$REGION"
  echo '. $HOME/snakemake-executor-plugin-aws-batch-flex/.venv/bin/activate'
  echo 'cd $HOME/snakemake-executor-plugin-aws-batch-flex/examples/smoke-test'
} >> "$HOME/.bashrc"
EOS

sudo -u ec2-user env HOME=/home/ec2-user BUCKET='${bucket}' KEY='${key}' REGION='${region}' \
  QUEUE='${queue}' WORKDIR='${workdir}' JOB_ROLE='${job_role}' \
  SMK_VER='${snakemake_version}' S3_VER='${s3_plugin_version}' bash /tmp/setup-user.sh
touch /home/ec2-user/.snakemake-setup-done
