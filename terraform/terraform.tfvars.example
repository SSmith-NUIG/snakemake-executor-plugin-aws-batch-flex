# Copy to terraform.tfvars and fill in the two REPLACE values.
region = "eu-west-1"                   # the AWS region you want to run in
name   = "smkflex"                     # prefix for everything created; <name>-queue must not exist yet

# Subnets with internet access (the default VPC's subnets work); find them with
#   aws ec2 describe-subnets --filters Name=default-for-az,Values=true --query 'Subnets[].SubnetId'
subnet_ids = ["subnet-REPLACE", "subnet-REPLACE"]

# The AMI printed at the end of scripts/bake-ami.sh
ami_id = "ami-REPLACE"

root_volume_gib = 100                  # disk per instance (container images + job files)

# Optional:
# enable_fargate = true                # also create a Fargate queue
# use_spot       = true                # cheaper Spot instances (can be interrupted; untested)
# max_vcpus      = 256                 # upper limit on instances running at once
# s3_bucket      = "my-bucket"         # use an existing bucket instead of creating one
